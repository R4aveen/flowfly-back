datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ENUMS
enum AssetType {
  CASH
  SAVINGS_ACCOUNT
  EMERGENCY_FUND
  INVESTMENT_ACCOUNT
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum EntropyRiskLevel {
  LOW
  MODERATE
  HIGH
  CRITICAL
  EXTRAORDINARY
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ABANDONED
}

// MODELOS CORE
model UserProfile {
  id               String   @id @default(uuid())
  email            String   @unique
  password         String
  name             String
  netMonthlyIncome Decimal  @db.Decimal(10, 2)
  monthlyWorkHours Int
  hourlyWage       Decimal  @db.Decimal(10, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  assets           Asset[]
  transactions     Transaction[]
  salaryHistories  SalaryHistory[]
  savingGoals      SavingGoal[]
  futureDesires    FutureDesire[]
  monthlySnapshots MonthlySnapshot[]
}

model SalaryHistory {
  id               String      @id @default(uuid())
  userId           String
  user             UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseNetIncome    Decimal     @db.Decimal(10, 2)
  monthlyWorkHours Int
  hourlyWage       Decimal     @db.Decimal(10, 2)
  startDate        DateTime    @default(now())
  endDate          DateTime?
  createdAt        DateTime    @default(now())

  @@index([userId, startDate])
}

model Asset {
  id          String      @id @default(uuid())
  userId      String
  user        UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  balance     Decimal     @db.Decimal(12, 2)
  assetType   AssetType
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  transactions Transaction[]
  savingGoals SavingGoal[]
}

model Transaction {
  id          String      @id @default(uuid())
  userId      String
  user        UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId     String?
  asset       Asset?      @relation(fields: [assetId], references: [id], onDelete: SetNull)
  amount      Decimal     @db.Decimal(10, 2)
  type        TransactionType
  category    EntropyRiskLevel @default(LOW)
  description String
  lifeHoursCost Decimal?  @db.Decimal(10, 2)
  date        DateTime    @default(now())
  createdAt   DateTime    @default(now())

  @@index([userId, date])
}

model SavingGoal {
  id             String      @id @default(uuid())
  userId         String
  user           UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId        String?
  asset          Asset?      @relation(fields: [assetId], references: [id])
  name           String
  targetAmount   Decimal     @db.Decimal(12, 2)
  currentAmount  Decimal     @db.Decimal(12, 2) @default(0)
  status         GoalStatus  @default(ACTIVE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model FutureDesire {
  id                  String      @id @default(uuid())
  userId              String
  user                UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemName            String
  price               Decimal     @db.Decimal(10, 2)
  workHoursRequired   Decimal     @db.Decimal(10, 2)
  createdAt           DateTime    @default(now())
}

model MonthlySnapshot {
  id                  String      @id @default(uuid())
  userId              String
  user                UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  period              DateTime    
  totalIncome         Decimal     @db.Decimal(12, 2)
  totalExpenses       Decimal     @db.Decimal(12, 2)
  monthsOfFreedom     Decimal     @db.Decimal(8, 2)
  chaosIndex          Decimal     @db.Decimal(5, 2)
  survivalPressure    Decimal     @db.Decimal(5, 2)
  createdAt           DateTime    @default(now())

  @@unique([userId, period])
}